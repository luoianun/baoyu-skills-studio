# MySQL
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=baoyu_studio
MYSQL_USER=studio
MYSQL_PASSWORD=change_me_studio

# Backend
JWT_SECRET_KEY=change_me_very_long_random_secret

# Image generation API
IMAGE_MODEL_API_KEY=your-gemini-or-openai-key
IMAGE_MODEL_BASE_URL=          # OpenAI-compatible endpoint，Gemini 模式留空
